{
  "size": 10000,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        { "term": { "status.raw": "Allowed" } },
        { "range": { "application_details.residential_details.total_no_proposed_residential_units": { "gt": 0 } } },
        { "range": { "actual_commencement_date": { "gte": "01/01/2000", "lte": "31/12/2025" } } }
      ]
    }
  },
  "_source": [
    "status",
    "valid_date",
    "decision_date",
    "actual_commencement_date",
    "application_details.residential_details.total_no_proposed_residential_units"
  ]
}
